# Bichoteca — regras para Apache/LiteSpeed (Hostinger compartilhada)

# 1. Força HTTPS (o service worker e o "Instalar aplicativo" exigem)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# 2. Nunca cachear o service worker: senão a atualização não chega no aluno
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# 3. Cache longo para ícones
<FilesMatch "\.(png|svg|woff2)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# 4. Bloqueia acesso direto às credenciais
<FilesMatch "^config\.(php|example\.php)$">
  Require all denied
</FilesMatch>

# 4b. O deploy por FTP cria este índice de arquivos no servidor.
#     Ele é legível por qualquer um se ficar exposto.
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  Require all denied
</FilesMatch>

# 5. Some com a listagem de diretórios
Options -Indexes

# 6. Cabeçalhos de segurança
<IfModule mod_headers.c>
  # HSTS: depois do primeiro acesso HTTPS, o navegador nunca mais tenta HTTP de novo
  # nesse domínio (nem se alguém digitar http:// na mão) — 1 ano, já valendo pra subdomínios
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # navegador não tenta "adivinhar" o tipo de um arquivo por conteúdo — evita truque de
  # disfarçar um upload malicioso de imagem/áudio como script
  Header always set X-Content-Type-Options "nosniff"
  # o site nunca precisa ser embutido em <iframe> de outra página — bloqueia clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # não vaza a URL completa (com apelido etc na query, se algum dia tiver) pra terceiros
  # quando o aluno clica num link que sai do site
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
