# Pasta de upload: só imagem/áudio entra aqui (api/admin.php valida extensão e confere com
# getimagesize antes de gravar). Esta regra é a segunda tranca: mesmo que algum dia um
# arquivo executável chegue aqui, o servidor se recusa a servi-lo.
<FilesMatch "\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh|html?|js)$">
  Require all denied
</FilesMatch>
